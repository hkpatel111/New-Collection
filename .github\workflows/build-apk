name: Build LendMate APK

# Manual trigger from the Actions tab, plus auto-build on pushes to main/master
# and on version tags (v*) — tags also publish the APK to a GitHub Release.
on:
  workflow_dispatch:
  push:
    branches: [main, master]
    tags: ['v*']

jobs:
  build-apk:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # Android Gradle Plugin needs JDK 17+
      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Flutter (stable)
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Verify zip exists
        run: |
          if [ ! -f lendmate-source.zip ]; then
            echo "::error::lendmate-source.zip repo root me nahi mila!"
            exit 1
          fi
          ls -lh lendmate-source.zip

      - name: Extract source code
        run: |
          mkdir -p app-src
          unzip -q lendmate-source.zip -d app-src
          # Agar zip ne ek hi root folder me sab rakha hai to uske andar chale jao
          if [ ! -f app-src/pubspec.yaml ]; then
            first_dir=$(find app-src -maxdepth 1 -mindepth 1 -type d | head -n1)
            if [ -f "$first_dir/pubspec.yaml" ]; then
              mv "$first_dir" app-src-new
              rm -rf app-src
              mv app-src-new app-src
            fi
          fi
          ls -la app-src
          test -f app-src/pubspec.yaml || { echo "::error::pubspec.yaml zip me nahi mila"; exit 1; }

      - name: Generate Android platform folder
        working-directory: app-src
        run: |
          flutter config --no-analytics
          flutter create . \
            --org com.lendmate \
            --project-name lendmate \
            --platforms android

      - name: Add required Android permissions
        working-directory: app-src
        run: |
          MANIFEST=android/app/src/main/AndroidManifest.xml
          chmod +w "$MANIFEST"
          python3 - "$MANIFEST" <<'EOF'
          import sys
          path = sys.argv[1]
          src = open(path).read()
          perms = [
            'android.permission.INTERNET',
            'android.permission.POST_NOTIFICATIONS',
            'android.permission.SCHEDULE_EXACT_ALARM',
            'android.permission.USE_BIOMETRIC',
            'android.permission.USE_FINGERPRINT',
            'android.permission.CAMERA',
            'android.permission.READ_MEDIA_IMAGES',
          ]
          insert = ''.join(
            f'    <uses-permission android:name="{p}"/>\n'
            for p in perms if p not in src
          )
          if insert:
            src = src.replace('<application', insert + '    <application', 1)
          open(path, 'w').write(src)
          print(f'Permissions added to {path}')
          EOF

      # Safety: agar flutter create ka default widget test ghusa ho (MyApp
      # exist nahi karta) to hata do — humara apna test zip me shipped hai.
      - name: Drop conflicting default widget test
        working-directory: app-src
        run: |
          if [ -f test/widget_test.dart ] && grep -q "MyApp" test/widget_test.dart; then
            rm test/widget_test.dart
            echo "Default MyApp widget test removed"
          fi

      - name: Resolve dependencies
        working-directory: app-src
        run: flutter pub get

      # Optional: Google-services config from repo secrets (skip if not set —
      # app tab placeholder firebase_options pe Setup screen dikhayegi)
      - name: Decode google-services.json (optional secret)
        working-directory: app-src
        env:
          GOOGLE_SERVICES_JSON: ${{ secrets.GOOGLE_SERVICES_JSON }}
        run: |
          if [ -n "$GOOGLE_SERVICES_JSON" ]; then
            echo "$GOOGLE_SERVICES_JSON" | base64 --decode > android/app/google-services.json
            echo "google-services.json written from secret"
          else
            echo "GOOGLE_SERVICES_JSON secret set nahi hai — build placeholder options ke saath chalega."
          fi

      - name: Run unit tests
        working-directory: app-src
        run: flutter test

      - name: Analyze (warnings allowed, errors fail)
        working-directory: app-src
        run: flutter analyze --no-fatal-infos --no-fatal-warnings

      - name: Build release APK
        working-directory: app-src
        run: flutter build apk --release

      - name: Rename APK
        working-directory: app-src
        run: |
          mkdir -p ../out
          cp build/app/outputs/flutter-apk/app-release.apk ../out/LendMate-release.apk
          ls -lh ../out

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: LendMate-release-apk
          path: out/LendMate-release.apk
          if-no-files-found: error

      # Optional auto-release: set a tag (v*) push pe APK release ke saath attach hoga.
      - name: Attach to GitHub Release (only on v* tags)
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: out/LendMate-release.apk
